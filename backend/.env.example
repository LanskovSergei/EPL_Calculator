# Скопируй в .env (сам .env в git не попадёт — см. .gitignore) и впиши свой ключ.

# Ключ Яндекс.Геокодера: https://developer.tech.yandex.ru/ -> сервис "Геокодер"
YANDEX_GEOCODER_API_KEY=

# Токен сервиса проверки чеков (напр. proverkacheka.com) — для валидации
# чеков ГСМ через ОФД. Пока не задан, валидация просто не выполняется.
OFD_CHECK_TOKEN=

# Интеграция с 1С (OData/HTTP-сервис). Пока ONE_C_BASE_URL не задан,
# синхронизация Акта не выполняется, но сам Акт всё равно строится.
ONE_C_BASE_URL=
ONE_C_ENTITY=Document_СписаниеГСМ
ONE_C_USERNAME=
ONE_C_PASSWORD=
ONE_C_VERIFY_SSL=true

# CORS: через запятую, без пробелов вокруг запятых
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
